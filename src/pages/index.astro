---
/**
 * Official GitHub Pages (OPENBLOG_OFFICIAL_LANDING=1) shows the project landing.
 * Cloned blogs keep the normal Markdown blog home.
 */
import BlogHome from '../components/BlogHome.astro';
import OfficialLanding from '../components/OfficialLanding.astro';

const officialLanding = process.env.OPENBLOG_OFFICIAL_LANDING === '1';
---

{officialLanding ? <OfficialLanding /> : <BlogHome />}
