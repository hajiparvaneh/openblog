---
import BlogLayout from '../layouts/BlogLayout.astro';
import FeaturedPostsSlider from '../components/FeaturedPostsSlider.astro';
import LatestPostCard from '../components/LatestPostCard.astro';
import PostCard from '../components/PostCard.astro';
import {
  getCategoryPath,
  getPosts,
  getTagRecords
} from '../lib/posts';
import { getOpenBlogConfig, getSiteUrl } from '../lib/site';
import { toAbsoluteUrl } from '../lib/seo';
import { withBase } from '../lib/paths';

const config = getOpenBlogConfig();
const posts = getPosts();
const latestPost = posts[0];
const CATEGORY_INSIGHTS_LIMIT = 8;
const remainingPosts = posts
  .slice(1)
  .sort((a, b) => b.date.localeCompare(a.date) || a.slug.localeCompare(b.slug));
const archivePosts = remainingPosts;
const categoryCount = new Set(posts.map((post) => post.category)).size;
const featuredPostCount = posts.filter((post) => post.featured).length;
const tagRecords = getTagRecords();
const tagCount = tagRecords.length;

const categoryInsightsMap = new Map<string, {
  key: string;
  label: string;
  postCount: number;
  featuredCount: number;
  latestDate: string;
}>();

for (const post of posts) {
  const current = categoryInsightsMap.get(post.category) ?? {
    key: post.category,
    label: post.categoryLabel,
    postCount: 0,
    featuredCount: 0,
    latestDate: post.date
  };

  current.postCount += 1;
  if (post.featured) current.featuredCount += 1;
  if (post.date > current.latestDate) current.latestDate = post.date;

  categoryInsightsMap.set(post.category, current);
}

const categoryInsights = [...categoryInsightsMap.values()]
  .sort((a, b) => b.postCount - a.postCount || a.label.localeCompare(b.label))
  .slice(0, CATEGORY_INSIGHTS_LIMIT);

const faqEntries = [
  {
    question: 'How do I publish a new post?',
    answer:
      'Create a Markdown file under content/posts/<category>/, fill in frontmatter (title, description, date, tags), then commit and open a pull request. After merge, the site rebuilds automatically.'
  },
  {
    question: 'How do I brand this blog as my own?',
    answer:
      'Edit openblog.config.ts for title, tagline, colors, and navigation. Replace files under public/branding/ with your logo, favicon, and Open Graph image.'
  },
  {
    question: 'Where should I host it?',
    answer:
      'GitHub Pages works out of the box with the included workflow. Set SITE_URL to your origin and OPENBLOG_BASE_PATH if you publish under a project path.'
  },
  {
    question: 'Can I keep this free of accounts and scoring?',
    answer:
      'Yes. This template is a static Markdown blog only. Community features like OAuth, leaderboards, and contribution scoring live in the separate openblog.cc preview repo.'
  }
] as const;

const pageDescription = config.description;
const canonicalPath = '/';
const siteUrl = getSiteUrl(Astro.site);
const canonicalUrl = toAbsoluteUrl(canonicalPath, siteUrl);
const aboutHref = withBase('/about');
const repoUrl = config.repositoryUrl;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: config.title,
    description: pageDescription,
    url: toAbsoluteUrl('/', siteUrl)
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `${config.title} Home`,
    description: pageDescription,
    url: canonicalUrl
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqEntries.map((entry) => ({
      '@type': 'Question',
      name: entry.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: entry.answer
      }
    }))
  }
];
---
<BlogLayout
  title={`${config.title} | ${config.tagline}`}
  description={pageDescription}
  canonicalPath={canonicalPath}
  structuredData={structuredData}
>
  <section class="card hero">
    <div class="hero-main">
      <p class="kicker icon-label"><i class="ti ti-news icon-sm" aria-hidden="true"></i>Open source publication</p>
      <h1>{config.heroHeadline}</h1>
      <p class="meta">{config.heroSupporting}</p>
      <div class="hero-actions">
        <a class="home-cta" href={repoUrl} target="_blank" rel="noopener noreferrer">
          <i class="ti ti-brand-github icon-sm" aria-hidden="true"></i>
          Clone the template
        </a>
        <a class="home-cta home-cta-soft" href={aboutHref}>
          <i class="ti ti-info-circle icon-sm" aria-hidden="true"></i>
          About this blog
        </a>
      </div>
      <ul class="hero-highlights">
        <li class="hero-highlight"><i class="ti ti-markdown icon-sm" aria-hidden="true"></i>Posts live as Markdown in Git</li>
        <li class="hero-highlight"><i class="ti ti-palette icon-sm" aria-hidden="true"></i>Brand from one config file</li>
        <li class="hero-highlight"><i class="ti ti-rocket icon-sm" aria-hidden="true"></i>Publish with GitHub Pages — no secrets required</li>
      </ul>
    </div>

    <div class="hero-side">
      <p class="kicker icon-label"><i class="ti ti-chart-bar icon-sm" aria-hidden="true"></i>Blog snapshot</p>
      <div class="stats">
        <div class="stat">
          <span class="stat-value stat-head"><i class="ti ti-notes icon-sm" aria-hidden="true"></i>{posts.length}</span>
          <span class="stat-label">Published posts</span>
        </div>
        <div class="stat">
          <span class="stat-value stat-head"><i class="ti ti-category icon-sm" aria-hidden="true"></i>{categoryCount}</span>
          <span class="stat-label">Active categories</span>
        </div>
        <div class="stat">
          <span class="stat-value stat-head"><i class="ti ti-star-filled icon-sm" aria-hidden="true"></i>{featuredPostCount}</span>
          <span class="stat-label">Featured stories</span>
        </div>
        <div class="stat">
          <span class="stat-value stat-head"><i class="ti ti-tags icon-sm" aria-hidden="true"></i>{tagCount}</span>
          <span class="stat-label">Indexed tags</span>
        </div>
      </div>
    </div>
  </section>

  <nav class="card home-jump-links" aria-label="Homepage sections">
    <a href="#home-posts"><i class="ti ti-list icon-sm" aria-hidden="true"></i>All stories</a>
    <a href="#home-categories"><i class="ti ti-category icon-sm" aria-hidden="true"></i>Categories</a>
    <a href="#home-faq"><i class="ti ti-help-hexagon icon-sm" aria-hidden="true"></i>FAQ</a>
  </nav>

  <FeaturedPostsSlider posts={posts} limit={5} class="card" />

  {latestPost ? <LatestPostCard post={latestPost} /> : null}

  {archivePosts.length > 0 ? (
    <section id="home-posts" class="card list home-posts-section">
      <div class="section-head section-head-inline">
        <div>
          <p class="kicker icon-label"><i class="ti ti-list icon-sm" aria-hidden="true"></i>Browse all stories</p>
          <h2>Complete post archive</h2>
        </div>
        <p class="meta pagination-info">{archivePosts.length} posts</p>
      </div>

      <div class="post-grid">
        {archivePosts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    </section>
  ) : (
    <section id="home-posts" class="card list home-posts-section">
      <p class="kicker icon-label"><i class="ti ti-list icon-sm" aria-hidden="true"></i>Browse all stories</p>
      <article class="home-empty-state">
        <h2>{latestPost ? 'More stories are on the way' : 'No posts yet'}</h2>
        <p class="meta">
          {latestPost
            ? 'Only one post is available right now. Add another Markdown file under content/posts/.'
            : 'Add a Markdown file under content/posts/<category>/ to publish your first post.'}
        </p>
      </article>
    </section>
  )}

  {categoryInsights.length > 0 ? (
    <section id="home-categories" class="card home-categories">
      <div class="section-head">
        <div>
          <p class="kicker icon-label"><i class="ti ti-category icon-sm" aria-hidden="true"></i>Explore by topic</p>
          <h2>Categories</h2>
        </div>
        <p class="meta">Browse posts grouped by folder under content/posts/.</p>
      </div>
      <div class="category-insights-grid">
        {categoryInsights.map((category) => (
          <a class="category-insight-card" href={withBase(getCategoryPath(category.key))}>
            <h3>{category.label}</h3>
            <p class="meta">Latest {category.latestDate}</p>
            <div class="category-insight-stats">
              <span class="category-insight-stat">
                <i class="ti ti-notes icon-sm" aria-hidden="true"></i>
                {category.postCount} posts
              </span>
              {category.featuredCount > 0 ? (
                <span class="category-insight-stat">
                  <i class="ti ti-star-filled icon-sm" aria-hidden="true"></i>
                  {category.featuredCount} featured
                </span>
              ) : null}
            </div>
          </a>
        ))}
      </div>
    </section>
  ) : null}

  <section id="home-faq" class="card home-faq">
    <div class="section-head">
      <div>
        <p class="kicker icon-label"><i class="ti ti-help-hexagon icon-sm" aria-hidden="true"></i>Getting started FAQ</p>
        <h2>Common questions before your first post</h2>
      </div>
      <p class="meta">Short answers for cloning, branding, and publishing this template.</p>
    </div>

    <div class="faq-list">
      {faqEntries.map((entry, index) => (
        <details class="faq-item" open={index === 0}>
          <summary>{entry.question}</summary>
          <p class="meta">{entry.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <style>
    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      align-items: start;
      gap: 0.85rem;
    }

    .hero-main h1 {
      margin-bottom: 0.55rem;
    }

    .hero-actions {
      margin-top: 0.9rem;
      display: flex;
      flex-wrap: wrap;
      gap: 0.55rem;
    }

    .home-cta {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      border: 1px solid var(--success);
      border-radius: var(--radius-sm);
      background: var(--success);
      color: #fff;
      font-family: var(--font-main);
      font-size: 0.82rem;
      font-weight: 600;
      line-height: 1;
      padding: 0.5rem 0.7rem;
      text-decoration: none;
    }

    .home-cta:hover {
      color: #fff;
      background: var(--success-strong);
      border-color: var(--success-strong);
    }

    .home-cta-soft {
      border-color: var(--border);
      background: var(--surface);
      color: var(--text);
    }

    .home-cta-soft:hover {
      color: var(--text);
      background: var(--surface-soft);
      border-color: var(--primary);
    }

    .hero-highlights {
      list-style: none;
      margin: 0.85rem 0 0;
      padding: 0;
      display: grid;
      gap: 0.38rem;
    }

    .hero-highlight {
      display: inline-flex;
      align-items: center;
      gap: 0.32rem;
      color: var(--muted);
      font-family: var(--font-main);
      font-size: 0.84rem;
      font-weight: 600;
      line-height: 1.3;
    }

    .hero-side {
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      background: var(--surface);
      padding: 0.62rem;
      display: grid;
      gap: 0.52rem;
      box-shadow: var(--shadow-xs);
    }

    .hero-side .stats {
      margin-top: 0.45rem;
      gap: 0.45rem;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .hero-side .stat {
      background: var(--surface);
      padding: 0.52rem;
    }

    .hero-side .stat-value {
      font-size: 1.05rem;
    }

    [id^='home-'] {
      scroll-margin-top: 1rem;
    }

    .home-jump-links {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(135px, 1fr));
      gap: 0.45rem;
    }

    .home-jump-links a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.32rem;
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      background: var(--surface);
      color: var(--text);
      font-family: var(--font-main);
      font-size: 0.76rem;
      font-weight: 600;
      line-height: 1;
      padding: 0.3rem 0.5rem;
      text-decoration: none;
    }

    .home-jump-links a:hover {
      border-color: var(--primary);
      background: var(--surface-soft);
    }

    .home-faq,
    .home-categories {
      display: grid;
      gap: 0.62rem;
    }

    .section-head {
      display: grid;
      gap: 0.32rem;
      margin-bottom: 0.55rem;
    }

    .section-head h2 {
      margin: 0;
      font-size: 1.35rem;
    }

    .section-head .meta {
      margin: 0;
      font-size: 0.82rem;
    }

    .section-head-inline {
      display: flex;
      flex-wrap: wrap;
      align-items: end;
      justify-content: space-between;
      gap: 0.5rem;
      margin-bottom: 0;
    }

    .section-head-inline .meta {
      margin-left: auto;
    }

    .home-posts-section {
      gap: 0.65rem;
    }

    .list-limit-note {
      margin: 0.05rem 0 0;
      font-size: 0.76rem;
      line-height: 1.25;
    }

    .category-insights-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      align-items: start;
      gap: 0.5rem;
    }

    .category-insight-card {
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      background: var(--surface);
      padding: 0.5rem;
      display: grid;
      gap: 0.3rem;
      min-width: 0;
      text-decoration: none;
      color: inherit;
    }

    .category-insight-card:hover {
      border-color: var(--primary);
      background: var(--surface-soft);
    }

    .category-insight-card h3 {
      margin: 0;
      font-size: 1rem;
    }

    .category-insight-card .meta {
      margin: 0;
      font-size: 0.75rem;
    }

    .category-insight-stats {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
    }

    .category-insight-stat {
      display: inline-flex;
      align-items: center;
      gap: 0.22rem;
      color: var(--muted);
      font-family: var(--font-main);
      font-size: 0.72rem;
      font-weight: 400;
      line-height: 1.2;
    }

    .tag-cloud {
      display: flex;
      flex-wrap: wrap;
      gap: 0.38rem;
    }

    .tag-cloud-item {
      display: inline-flex;
      align-items: center;
      gap: 0.38rem;
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      background: var(--surface);
      color: var(--text);
      font-family: var(--font-main);
      font-size: 0.82rem;
      font-weight: 600;
      line-height: 1;
      padding: 0.3rem 0.42rem;
      text-decoration: none;
    }

    .tag-cloud-item .badge {
      font-size: 0.68rem;
      padding: 0.12rem 0.35rem;
      background: var(--surface);
    }

    .tag-cloud-item:hover {
      border-color: var(--primary);
      background: var(--surface-soft);
      color: var(--text);
    }

    .faq-list {
      display: grid;
      gap: 0.45rem;
    }

    .faq-item {
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      background: var(--surface);
      padding: 0.5rem 0.62rem;
    }

    .faq-item[open] {
      border-color: color-mix(in srgb, var(--primary) 45%, var(--border));
      background: var(--surface);
    }

    .faq-item summary {
      cursor: pointer;
      font-family: var(--font-main);
      font-size: 0.88rem;
      font-weight: 700;
      line-height: 1.35;
      color: var(--text);
    }

    .faq-item .meta {
      margin: 0.42rem 0 0;
      font-size: 0.8rem;
      line-height: 1.45;
    }

    .home-empty-state {
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      background: var(--surface);
      padding: 0.75rem;
    }

    .home-empty-state h2 {
      margin: 0 0 0.35rem;
    }

    .home-empty-state .meta {
      margin: 0;
    }

    @media (max-width: 1080px) {
      .hero {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 860px) {
      .home-jump-links {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .hero-side .stats {
        grid-template-columns: 1fr;
      }

      .section-head h2 {
        font-size: 1.15rem;
      }

      .section-head-inline .meta {
        margin-left: 0;
      }
    }

    @media (max-width: 560px) {
      .home-jump-links {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BlogLayout>
