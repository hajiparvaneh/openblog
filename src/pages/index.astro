---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedPostsSlider from '../components/FeaturedPostsSlider.astro';
import LatestPostCard from '../components/LatestPostCard.astro';
import PostCard from '../components/PostCard.astro';
import {
  getCategoryPath,
  getPosts,
  getTagPath,
  getTagRecords
} from '../lib/posts';
import { getOpenBlogConfig, getSiteUrl } from '../lib/site';
import { toAbsoluteUrl } from '../lib/seo';
import { withBase } from '../lib/paths';

const config = getOpenBlogConfig();
const posts = getPosts();
const latestPost = posts[0];
const CATEGORY_INSIGHTS_LIMIT = 8;
const remainingPosts = posts
  .slice(1)
  .sort((a, b) => b.date.localeCompare(a.date) || a.slug.localeCompare(b.slug));
const postsPerPage = 6;
const postsTotalPages = Math.max(1, Math.ceil(remainingPosts.length / postsPerPage));
const currentPage = 1;
const pageStart = (currentPage - 1) * postsPerPage;
const paginatedPosts = remainingPosts.slice(pageStart, pageStart + postsPerPage);
const postPageNumbers = Array.from({ length: postsTotalPages }, (_, index) => index + 1);
const categoryCount = new Set(posts.map((post) => post.category)).size;
const featuredPostCount = posts.filter((post) => post.featured).length;
const TAGS_LIMIT = 20;
const tagRecords = getTagRecords();
const topTags = tagRecords.slice(0, TAGS_LIMIT);
const tagCount = tagRecords.length;
const hiddenTagCount = Math.max(0, tagRecords.length - topTags.length);

const categoryInsightsMap = new Map<string, {
  key: string;
  label: string;
  postCount: number;
  featuredCount: number;
  latestDate: string;
}>();

for (const post of posts) {
  const current = categoryInsightsMap.get(post.category) ?? {
    key: post.category,
    label: post.categoryLabel,
    postCount: 0,
    featuredCount: 0,
    latestDate: post.date
  };

  current.postCount += 1;
  if (post.featured) current.featuredCount += 1;
  if (post.date > current.latestDate) current.latestDate = post.date;

  categoryInsightsMap.set(post.category, current);
}

const categoryInsights = [...categoryInsightsMap.values()]
  .sort((a, b) => b.postCount - a.postCount || a.label.localeCompare(b.label))
  .slice(0, CATEGORY_INSIGHTS_LIMIT);

const faqEntries = [
  {
    question: 'What is OpenBlog?',
    answer:
      'OpenBlog is a free, open-source blogging template. Posts are Markdown files in a GitHub repository, and the site publishes as static pages.'
  },
  {
    question: 'How should I read this starter site?',
    answer:
      'Start with the featured posts. They explain that OpenBlog is free, file-based, GitHub-based, and MIT licensed. Use the Blog category or tags to jump between them.'
  },
  {
    question: 'How are posts organized?',
    answer:
      'Each post sits in a category folder and can include tags. Category and tag pages help you browse without scrolling the full archive.'
  },
  {
    question: 'Can I share a post?',
    answer:
      'Yes. Use the share control on a post page, or copy the URL from your browser.'
  }
] as const;

const getHomePagePath = (page: number): string => withBase(page <= 1 ? '/' : `/page/${page}`);

const pageDescription = config.description;
const canonicalPath = '/';
const siteUrl = getSiteUrl(Astro.site);
const canonicalUrl = toAbsoluteUrl(canonicalPath, siteUrl);
const aboutHref = withBase('/about');
const postsAnchor = '#home-posts';

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: config.title,
    description: pageDescription,
    url: toAbsoluteUrl('/', siteUrl)
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `${config.title} Home`,
    description: pageDescription,
    url: canonicalUrl
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `${config.title} Top Categories`,
    itemListElement: categoryInsights.slice(0, 6).map((category, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: toAbsoluteUrl(withBase(getCategoryPath(category.key)), siteUrl),
      name: category.label
    }))
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqEntries.map((entry) => ({
      '@type': 'Question',
      name: entry.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: entry.answer
      }
    }))
  }
];
---
<BaseLayout
  title={`${config.title} | ${config.tagline}`}
  description={pageDescription}
  canonicalPath={canonicalPath}
  structuredData={structuredData}
>
  <section class="card hero">
    <div class="hero-main">
      <p class="kicker icon-label"><i class="ti ti-news icon-sm" aria-hidden="true"></i>Technical blog</p>
      <h1>{config.heroHeadline}</h1>
      <p class="meta">{config.heroSupporting}</p>
      <div class="hero-actions">
        <a class="home-cta" href={postsAnchor}>
          <i class="ti ti-list icon-sm" aria-hidden="true"></i>
          Browse posts
        </a>
        <a class="home-cta home-cta-soft" href={aboutHref}>
          <i class="ti ti-info-circle icon-sm" aria-hidden="true"></i>
          About
        </a>
      </div>
      <ul class="hero-highlights">
        <li class="hero-highlight"><i class="ti ti-markdown icon-sm" aria-hidden="true"></i>Posts are plain Markdown files</li>
        <li class="hero-highlight"><i class="ti ti-brand-github icon-sm" aria-hidden="true"></i>Hosted and versioned on GitHub</li>
        <li class="hero-highlight"><i class="ti ti-license icon-sm" aria-hidden="true"></i>Free and open source under MIT</li>
      </ul>
    </div>

    <div class="hero-side">
      <p class="kicker icon-label"><i class="ti ti-chart-bar icon-sm" aria-hidden="true"></i>At a glance</p>
      <div class="stats">
        <div class="stat">
          <span class="stat-value stat-head"><i class="ti ti-notes icon-sm" aria-hidden="true"></i>{posts.length}</span>
          <span class="stat-label">Published posts</span>
        </div>
        <div class="stat">
          <span class="stat-value stat-head"><i class="ti ti-category icon-sm" aria-hidden="true"></i>{categoryCount}</span>
          <span class="stat-label">Active categories</span>
        </div>
        <div class="stat">
          <span class="stat-value stat-head"><i class="ti ti-star-filled icon-sm" aria-hidden="true"></i>{featuredPostCount}</span>
          <span class="stat-label">Featured stories</span>
        </div>
        <div class="stat">
          <span class="stat-value stat-head"><i class="ti ti-tags icon-sm" aria-hidden="true"></i>{tagCount}</span>
          <span class="stat-label">Indexed tags</span>
        </div>
      </div>
    </div>
  </section>

  <nav class="card home-jump-links" aria-label="Homepage sections">
    <a href="#home-posts"><i class="ti ti-list icon-sm" aria-hidden="true"></i>All stories</a>
    <a href="#home-categories"><i class="ti ti-category icon-sm" aria-hidden="true"></i>Categories</a>
    <a href="#home-faq"><i class="ti ti-help-hexagon icon-sm" aria-hidden="true"></i>FAQ</a>
  </nav>

  <FeaturedPostsSlider posts={posts} limit={5} class="card" />

  {latestPost ? <LatestPostCard post={latestPost} /> : null}

  {topTags.length > 0 ? (
    <Fragment slot="sidebar-extra">
      <p class="kicker icon-label"><i class="ti ti-tags icon-sm" aria-hidden="true"></i>Popular tags</p>
      <nav aria-label="Popular tags">
        <div class="tag-cloud" role="list">
          {topTags.map((tag) => (
            <a role="listitem" class="tag-cloud-item" href={withBase(getTagPath(tag.label))}>
              <span>{tag.label}</span>
              <span class="badge">{tag.postCount}</span>
            </a>
          ))}
        </div>
      </nav>
      {hiddenTagCount > 0 ? (
        <p class="meta list-limit-note icon-label">
          <i class="ti ti-tags icon-sm" aria-hidden="true"></i>
          +{hiddenTagCount} more tags
        </p>
      ) : null}
    </Fragment>
  ) : null}

  {remainingPosts.length > 0 ? (
    <section id="home-posts" class="card list paginated-list home-posts-section">
      <div class="section-head section-head-inline">
        <div>
          <p class="kicker icon-label"><i class="ti ti-list icon-sm" aria-hidden="true"></i>Browse all stories</p>
          <h2>Complete post archive</h2>
        </div>
        <p id="home-posts-page-info" class="meta pagination-info">Page {currentPage} of {postsTotalPages} ({remainingPosts.length} posts)</p>
      </div>

      <div class="post-grid">
        {paginatedPosts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>

      {postsTotalPages > 1 && (
        <nav class="posts-pagination" aria-label="Homepage posts pages">
          <a
            id="home-posts-prev"
            class:list={['page-control', currentPage <= 1 && 'is-disabled']}
            href={getHomePagePath(Math.max(1, currentPage - 1))}
            aria-disabled={currentPage <= 1 ? 'true' : undefined}
          >
            Previous
          </a>
          <ul class="page-links" aria-label="Page numbers">
            {postPageNumbers.map((page) => (
              <li>
                <a class:list={['page-link', page === currentPage && 'is-active']} href={getHomePagePath(page)} aria-current={page === currentPage ? 'page' : undefined}>{page}</a>
              </li>
            ))}
          </ul>
          <a
            id="home-posts-next"
            class:list={['page-control', currentPage >= postsTotalPages && 'is-disabled']}
            href={getHomePagePath(Math.min(postsTotalPages, currentPage + 1))}
            aria-disabled={currentPage >= postsTotalPages ? 'true' : undefined}
          >
            Next
          </a>
        </nav>
      )}
    </section>
  ) : (
    <section id="home-posts" class="card list home-posts-section">
      <p class="kicker icon-label"><i class="ti ti-list icon-sm" aria-hidden="true"></i>Browse all stories</p>
      <article class="home-empty-state">
        <h2>{latestPost ? 'More stories are on the way' : 'No posts yet'}</h2>
        <p class="meta">
          {latestPost
            ? 'Only one post is available right now. Check back soon for more.'
            : 'New posts will appear here when they are published.'}
        </p>
      </article>
    </section>
  )}

  {categoryInsights.length > 0 ? (
    <section id="home-categories" class="card home-categories">
      <div class="section-head">
        <div>
          <p class="kicker icon-label"><i class="ti ti-category icon-sm" aria-hidden="true"></i>Explore by topic</p>
          <h2>Categories</h2>
        </div>
        <p class="meta">Pick a topic and open every post in that category.</p>
      </div>
      <div class="category-insights-grid">
        {categoryInsights.map((category) => (
          <a class="category-insight-card" href={withBase(getCategoryPath(category.key))}>
            <h3>{category.label}</h3>
            <p class="meta">Latest {category.latestDate}</p>
            <div class="category-insight-stats">
              <span class="category-insight-stat">
                <i class="ti ti-notes icon-sm" aria-hidden="true"></i>
                {category.postCount} posts
              </span>
              {category.featuredCount > 0 ? (
                <span class="category-insight-stat">
                  <i class="ti ti-star-filled icon-sm" aria-hidden="true"></i>
                  {category.featuredCount} featured
                </span>
              ) : null}
            </div>
          </a>
        ))}
      </div>
    </section>
  ) : null}

  <section id="home-faq" class="card home-faq">
    <div class="section-head">
      <div>
        <p class="kicker icon-label"><i class="ti ti-help-hexagon icon-sm" aria-hidden="true"></i>Reader FAQ</p>
        <h2>Common questions while browsing</h2>
      </div>
      <p class="meta">Quick answers if you are new to this archive.</p>
    </div>

    <div class="faq-list">
      {faqEntries.map((entry, index) => (
        <details class="faq-item" open={index === 0}>
          <summary>{entry.question}</summary>
          <p class="meta">{entry.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <script is:inline define:vars={{ homeBase: withBase('/') }}>
    (function () {
      var path = window.location.pathname.replace(/\/+$/, '') || '/';
      var base = (typeof homeBase === 'string' ? homeBase : '/').replace(/\/+$/, '') || '/';
      if (path !== base && path !== '/') return;
      var params = new URLSearchParams(window.location.search);
      var requestedPage = Number(params.get('page') || '1');
      if (!Number.isFinite(requestedPage) || requestedPage <= 1) return;
      var normalizedPage = Math.floor(requestedPage);
      var prefix = base === '/' ? '' : base;
      window.location.replace(prefix + '/page/' + normalizedPage + window.location.hash);
    })();
  </script>

  <style>
    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      align-items: start;
      gap: 0.85rem;
    }

    .hero-main h1 {
      margin-bottom: 0.55rem;
    }

    .hero-actions {
      margin-top: 0.9rem;
      display: flex;
      flex-wrap: wrap;
      gap: 0.55rem;
    }

    .home-cta {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      border: 1px solid var(--success);
      border-radius: var(--radius-sm);
      background: var(--success);
      color: #fff;
      font-family: var(--font-main);
      font-size: 0.82rem;
      font-weight: 600;
      line-height: 1;
      padding: 0.5rem 0.7rem;
      text-decoration: none;
    }

    .home-cta:hover {
      color: #fff;
      background: var(--success-strong);
      border-color: var(--success-strong);
    }

    .home-cta-soft {
      border-color: var(--border);
      background: var(--surface);
      color: var(--text);
    }

    .home-cta-soft:hover {
      color: var(--text);
      background: var(--surface-soft);
      border-color: var(--primary);
    }

    .hero-highlights {
      list-style: none;
      margin: 0.85rem 0 0;
      padding: 0;
      display: grid;
      gap: 0.38rem;
    }

    .hero-highlight {
      display: inline-flex;
      align-items: center;
      gap: 0.32rem;
      color: var(--muted);
      font-family: var(--font-main);
      font-size: 0.84rem;
      font-weight: 600;
      line-height: 1.3;
    }

    .hero-side {
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      background: var(--surface);
      padding: 0.62rem;
      display: grid;
      gap: 0.52rem;
      box-shadow: var(--shadow-xs);
    }

    .hero-side .stats {
      margin-top: 0.45rem;
      gap: 0.45rem;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .hero-side .stat {
      background: var(--surface);
      padding: 0.52rem;
    }

    .hero-side .stat-value {
      font-size: 1.05rem;
    }

    [id^='home-'] {
      scroll-margin-top: 1rem;
    }

    .home-jump-links {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(135px, 1fr));
      gap: 0.45rem;
    }

    .home-jump-links a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.32rem;
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      background: var(--surface);
      color: var(--text);
      font-family: var(--font-main);
      font-size: 0.76rem;
      font-weight: 600;
      line-height: 1;
      padding: 0.3rem 0.5rem;
      text-decoration: none;
    }

    .home-jump-links a:hover {
      border-color: var(--primary);
      background: var(--surface-soft);
    }

    .home-faq,
    .home-categories {
      display: grid;
      gap: 0.62rem;
    }

    .section-head {
      display: grid;
      gap: 0.32rem;
      margin-bottom: 0.55rem;
    }

    .section-head h2 {
      margin: 0;
      font-size: 1.35rem;
    }

    .section-head .meta {
      margin: 0;
      font-size: 0.82rem;
    }

    .section-head-inline {
      display: flex;
      flex-wrap: wrap;
      align-items: end;
      justify-content: space-between;
      gap: 0.5rem;
      margin-bottom: 0;
    }

    .section-head-inline .meta {
      margin-left: auto;
    }

    .home-posts-section {
      gap: 0.65rem;
    }

    .category-insights-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      align-items: start;
      gap: 0.5rem;
    }

    .category-insight-card {
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      background: var(--surface);
      padding: 0.5rem;
      display: grid;
      gap: 0.3rem;
      min-width: 0;
      text-decoration: none;
      color: inherit;
    }

    .category-insight-card:hover {
      border-color: var(--primary);
      background: var(--surface-soft);
    }

    .category-insight-card h3 {
      margin: 0;
      font-size: 1rem;
    }

    .category-insight-card .meta {
      margin: 0;
      font-size: 0.75rem;
    }

    .category-insight-stats {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
    }

    .category-insight-stat {
      display: inline-flex;
      align-items: center;
      gap: 0.22rem;
      color: var(--muted);
      font-family: var(--font-main);
      font-size: 0.72rem;
      font-weight: 400;
      line-height: 1.2;
    }

    .list-limit-note {
      margin: 0.05rem 0 0;
      font-size: 0.76rem;
      line-height: 1.25;
    }

    .tag-cloud {
      display: flex;
      flex-wrap: wrap;
      gap: 0.38rem;
    }

    .tag-cloud-item {
      display: inline-flex;
      align-items: center;
      gap: 0.38rem;
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      background: var(--surface);
      color: var(--text);
      font-family: var(--font-main);
      font-size: 0.82rem;
      font-weight: 600;
      line-height: 1;
      padding: 0.3rem 0.42rem;
      text-decoration: none;
    }

    .tag-cloud-item .badge {
      font-size: 0.68rem;
      padding: 0.12rem 0.35rem;
      background: var(--surface);
    }

    .tag-cloud-item:hover {
      border-color: var(--primary);
      background: var(--surface-soft);
      color: var(--text);
    }

    .faq-list {
      display: grid;
      gap: 0.45rem;
    }

    .faq-item {
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      background: var(--surface);
      padding: 0.5rem 0.62rem;
    }

    .faq-item[open] {
      border-color: color-mix(in srgb, var(--primary) 45%, var(--border));
      background: var(--surface);
    }

    .faq-item summary {
      cursor: pointer;
      font-family: var(--font-main);
      font-size: 0.88rem;
      font-weight: 700;
      line-height: 1.35;
      color: var(--text);
    }

    .faq-item .meta {
      margin: 0.42rem 0 0;
      font-size: 0.8rem;
      line-height: 1.45;
    }

    .home-empty-state {
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      background: var(--surface);
      padding: 0.75rem;
    }

    .home-empty-state h2 {
      margin: 0 0 0.35rem;
    }

    .home-empty-state .meta {
      margin: 0;
    }

    .posts-pagination {
      margin-top: 0.45rem;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
    }

    .page-links {
      margin: 0;
      padding: 0;
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
    }

    .page-control,
    .page-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 2rem;
      min-height: 2rem;
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      background: var(--surface);
      color: var(--text);
      font-family: var(--font-main);
      font-size: 0.82rem;
      font-weight: 600;
      line-height: 1;
      padding: 0.35rem 0.55rem;
      text-decoration: none;
    }

    .page-link.is-active {
      border-color: var(--primary);
      background: var(--surface-soft);
      color: var(--primary);
      text-decoration: none;
    }

    .page-control.is-disabled {
      opacity: 0.55;
      pointer-events: none;
    }

    @media (max-width: 1080px) {
      .hero {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 860px) {
      .posts-pagination {
        justify-content: center;
      }

      .home-jump-links {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .hero-side .stats {
        grid-template-columns: 1fr;
      }

      .section-head h2 {
        font-size: 1.15rem;
      }

      .section-head-inline .meta {
        margin-left: 0;
      }
    }

    @media (max-width: 560px) {
      .home-jump-links {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
