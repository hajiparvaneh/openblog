---
/**
 * Official GitHub Pages sets OPENBLOG_OFFICIAL_LANDING=1 (see astro.config define).
 * Local dev / template clones get the Markdown blog home only — no landing CSS.
 */
const Page =
  import.meta.env.OPENBLOG_OFFICIAL_LANDING === '1'
    ? (await import('../components/OfficialLanding.astro')).default
    : (await import('../components/BlogHome.astro')).default;
---

<Page />
