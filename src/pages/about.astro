---
import fs from 'node:fs';
import path from 'node:path';
import { marked } from 'marked';
import BlogLayout from '../layouts/BlogLayout.astro';
import { getOpenBlogConfig } from '../lib/site';

const config = getOpenBlogConfig();
const aboutPath = path.join(process.cwd(), config.aboutMarkdownPath);
const markdown = fs.existsSync(aboutPath)
  ? fs.readFileSync(aboutPath, 'utf8')
  : `# About\n\nAdd content in \`${config.aboutMarkdownPath}\`.`;
const html = marked.parse(markdown.replace(/^---[\s\S]*?---\n?/, ''));
---
<BlogLayout title={`About | ${config.title}`} description={config.description}>
  <article class="card article-content" set:html={html} />
</BlogLayout>
