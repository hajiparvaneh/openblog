---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import IconBadge from '../../components/IconBadge.astro';
import LanguageLabel from '../../components/LanguageLabel.astro';
import TagBadge from '../../components/TagBadge.astro';
import { renderMarkdown } from '../../lib/markdown';
import {
  formatPostDate,
  formatReadingTime,
  getCategoryPath,
  getPostAuthor,
  getPostBySlug,
  getPostPath,
  getPosts,
  getRelatedPosts,
  getSeriesPath,
  getSeriesPosts,
  getTranslationGroup
} from '../../lib/posts';
import { getOpenBlogConfig, getSiteUrl } from '../../lib/site';
import { toAbsoluteUrl } from '../../lib/seo';
import { withBase } from '../../lib/paths';

// Eager glob keeps Markdown in this page's Vite graph so `astro dev` refreshes routes on content changes.
const markdownModules = import.meta.glob('../../../content/posts/**/*.md', {
  eager: true,
  query: '?raw',
  import: 'default'
}) as Record<string, string>;
void markdownModules;

export function getStaticPaths() {
  return getPosts().map((post) => ({ params: { slug: post.slug } }));
}

const slugParam = Astro.params.slug;
const slug = Array.isArray(slugParam) ? slugParam.join('/') : slugParam ?? '';
const post = getPostBySlug(slug);
if (!post) throw new Error('Post not found');

const config = getOpenBlogConfig();
const rendered = await renderMarkdown(post.body);
const html = rendered.html;
const toc = rendered.toc;
const categoryPath = withBase(getCategoryPath(post.category));
const canonicalPath = post.canonical || getPostPath(post.slug);
const pageDescription = post.description || `Read ${post.title} on ${config.title}.`;
const siteUrl = getSiteUrl(Astro.site);
const canonicalUrl = toAbsoluteUrl(post.canonical ? post.canonical : withBase(canonicalPath), siteUrl);
const author = getPostAuthor(post, config);
const authorAvatar = author.avatar
  ? author.avatar.startsWith('http')
    ? author.avatar
    : withBase(author.avatar)
  : undefined;
const relatedPosts = getRelatedPosts(post);
const translations = getTranslationGroup(post);
const showTranslations = translations.length > 1;
const seriesPosts = post.seriesSlug ? getSeriesPosts(post.seriesSlug) : [];
const seriesIndex = seriesPosts.findIndex((entry) => entry.slug === post.slug);
const previousInSeries = seriesIndex > 0 ? seriesPosts[seriesIndex - 1] : undefined;
const nextInSeries = seriesIndex >= 0 && seriesIndex < seriesPosts.length - 1 ? seriesPosts[seriesIndex + 1] : undefined;
const seriesPath = post.seriesSlug ? withBase(getSeriesPath(post.seriesSlug)) : undefined;
const translationUrl = (entry: typeof post) =>
  entry.slug === post.slug && post.canonical
    ? post.canonical
    : toAbsoluteUrl(withBase(getPostPath(entry.slug)), siteUrl);
const xDefault = translations.find((entry) => !entry.translateOfSlug) ?? translations.find((entry) => entry.lang === 'en') ?? translations[0];
const alternates = showTranslations
  ? [
      ...translations.map((entry) => ({ lang: entry.lang, href: translationUrl(entry) })),
      ...(xDefault ? [{ lang: 'x-default', href: translationUrl(xDefault) }] : [])
    ]
  : [];
const thumbnailSrc = post.thumbnail
  ? post.thumbnail.startsWith('http')
    ? post.thumbnail
    : withBase(post.thumbnail)
  : undefined;
const ogImagePath = post.thumbnail ?? config.ogImage;
const publishedTime = post.date ? `${post.date}T00:00:00Z` : undefined;
const modifiedTime = post.updated ? `${post.updated}T00:00:00Z` : undefined;
const homeHref = withBase('/');

const blogPostingSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: pageDescription,
  url: canonicalUrl,
  mainEntityOfPage: canonicalUrl,
  articleSection: post.categoryLabel,
  inLanguage: post.lang,
  timeRequired: `PT${post.readingMinutes}M`,
  author: {
    '@type': author.name === config.title ? 'Organization' : 'Person',
    name: author.name,
    ...(author.url ? { url: author.url } : {})
  },
  publisher: {
    '@type': 'Organization',
    name: config.title,
    url: toAbsoluteUrl(withBase('/'), siteUrl)
  }
};
if (post.date) blogPostingSchema.datePublished = post.date;
if (post.updated) blogPostingSchema.dateModified = post.updated;
if (config.contentLicense.url) blogPostingSchema.license = config.contentLicense.url;
if (post.tags.length > 0) blogPostingSchema.keywords = post.tags;
if (thumbnailSrc) {
  blogPostingSchema.image = [thumbnailSrc.startsWith('http') ? thumbnailSrc : toAbsoluteUrl(thumbnailSrc, siteUrl)];
}

const structuredData = [
  blogPostingSchema,
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: toAbsoluteUrl(withBase('/'), siteUrl)
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: post.categoryLabel,
        item: toAbsoluteUrl(categoryPath, siteUrl)
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: post.title,
        item: canonicalUrl
      }
    ]
  }
];
---
<BaseLayout
  title={`${post.title} | ${config.title}`}
  description={pageDescription}
  pageLang={post.lang}
  canonicalPath={canonicalPath}
  ogType="article"
  ogImagePath={ogImagePath}
  ogImageAlt={post.thumbnailAlt ?? post.title}
  robots={post.noindex ? 'noindex, follow' : 'index, follow'}
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  alternates={alternates}
  structuredData={structuredData}
>
  <article class="card">
    <p class="kicker icon-label">
      <i class="ti ti-home icon-sm" aria-hidden="true"></i>
      <a href={homeHref}>Home</a> / <a href={categoryPath}>{post.categoryLabel}</a>
    </p>
    <h1>{post.title}</h1>
    <p class="post-byline">
      {authorAvatar ? (
        <img src={authorAvatar} alt="" width="32" height="32" />
      ) : (
        <i class="ti ti-user icon-sm" aria-hidden="true"></i>
      )}
      <span>
        {author.url ? <a href={author.url}>{author.name}</a> : author.name}
      </span>
    </p>
    <p class="meta meta-inline">
      <span class="meta-item"><i class="ti ti-calendar icon-sm" aria-hidden="true"></i><time datetime={post.date}>{formatPostDate(post.date)}</time></span>
      {post.updated ? (
        <span class="meta-item"><i class="ti ti-refresh icon-sm" aria-hidden="true"></i>Updated <time datetime={post.updated}>{formatPostDate(post.updated)}</time></span>
      ) : null}
      <span class="meta-item"><i class="ti ti-clock-hour-4 icon-sm" aria-hidden="true"></i>{formatReadingTime(post.readingMinutes)}</span>
      <span class="meta-item"><i class="ti ti-category icon-sm" aria-hidden="true"></i><a href={categoryPath}>{post.categoryLabel}</a></span>
      <span class="meta-item share-article-meta">
        <button
          id="share-article-button"
          class="share-article-button"
          type="button"
          data-share-title={post.title}
          data-share-text={pageDescription}
          data-share-url={canonicalUrl}
          aria-label="Share this article"
        >
          <i class="ti ti-share icon-sm" aria-hidden="true"></i>
          Share this article
        </button>
        <span id="share-article-status" class="share-article-status" role="status" aria-live="polite" hidden></span>
      </span>
    </p>
    {thumbnailSrc ? (
      <>
        <figure class="post-thumbnail-wrap">
          <img
            class="post-thumbnail"
            src={thumbnailSrc}
            alt={post.thumbnailAlt ?? post.title}
            loading="eager"
            decoding="async"
          />
          <button
            type="button"
            class="post-thumbnail-open"
            data-thumbnail-open
            aria-controls="post-thumbnail-lightbox"
            aria-label="Open image in full view"
          >
            <i class="ti ti-arrows-maximize icon-sm" aria-hidden="true"></i>
          </button>
        </figure>
        <div
          id="post-thumbnail-lightbox"
          class="post-thumbnail-lightbox"
          role="dialog"
          aria-modal="true"
          aria-label="Expanded post image"
          hidden
        >
          <button
            type="button"
            class="post-thumbnail-lightbox-backdrop"
            data-thumbnail-close
            aria-label="Close image preview"
          />
          <div class="post-thumbnail-lightbox-panel" role="document">
            <button
              type="button"
              class="post-thumbnail-lightbox-close"
              data-thumbnail-close
              aria-label="Close image preview"
            >
              <i class="ti ti-x icon-sm" aria-hidden="true"></i>
              <span>Close</span>
            </button>
            <img
              class="post-thumbnail-lightbox-image"
              src={thumbnailSrc}
              alt={post.thumbnailAlt ?? post.title}
              loading="eager"
              decoding="async"
            />
          </div>
        </div>
      </>
    ) : null}
    <div class="post-meta-chips">
        {post.featured ? <IconBadge label="Featured" icon="star-filled" class="post-meta-chip" /> : null}
        <LanguageLabel lang={post.lang} class="post-meta-chip" />
        {post.tags.map((tag) => (
          <TagBadge tag={tag} class="post-meta-chip" />
        ))}
      </div>
    {post.series && seriesPath && seriesIndex >= 0 ? (
      <nav class="series-nav" aria-label={`${post.series} series`}>
        <p class="series-nav-label">
          <i class="ti ti-list-numbers icon-sm" aria-hidden="true"></i>
          <span>Part {seriesIndex + 1} of {seriesPosts.length}</span>
          <a href={seriesPath}>{post.series}</a>
        </p>
        {previousInSeries || nextInSeries ? (
          <p class="series-nav-steps">
            {previousInSeries ? (
              <a href={withBase(getPostPath(previousInSeries.slug))}>
                <i class="ti ti-arrow-left icon-sm" aria-hidden="true"></i>
                <span>{previousInSeries.title}</span>
              </a>
            ) : <span></span>}
            {nextInSeries ? (
              <a class="series-nav-next" href={withBase(getPostPath(nextInSeries.slug))}>
                <span>{nextInSeries.title}</span>
                <i class="ti ti-arrow-right icon-sm" aria-hidden="true"></i>
              </a>
            ) : null}
          </p>
        ) : null}
      </nav>
    ) : null}
    {showTranslations ? (
      <nav class="translation-nav" aria-label="Translations">
        <ul class="translation-list">
          {translations.map((entry) => (
            entry.slug === post.slug ? (
              <li><span lang={entry.lang} aria-current="page"><LanguageLabel lang={entry.lang} bare /></span></li>
            ) : (
              <li><a href={withBase(getPostPath(entry.slug))} hreflang={entry.lang} lang={entry.lang}><LanguageLabel lang={entry.lang} bare /></a></li>
            )
          ))}
        </ul>
      </nav>
    ) : null}
    {toc.length >= 2 ? (
      <details class="post-toc" open>
        <summary>On this page</summary>
        <ol>
          {toc.map((item) => (
            <li class={item.depth === 3 ? 'toc-depth-3' : undefined}>
              <a href={`#${item.id}`}>{item.text}</a>
            </li>
          ))}
        </ol>
      </details>
    ) : null}
    <div class="article-content" set:html={html} />
    {post.discussionUrl ? (
      <p class="meta">
        <a href={post.discussionUrl} rel="noopener noreferrer">Discuss this post</a>
      </p>
    ) : null}
    {config.contentLicense.name && config.contentLicense.url ? (
      <p class="meta">
        Content license: <a href={config.contentLicense.url} rel="noopener noreferrer">{config.contentLicense.name}</a>
      </p>
    ) : null}
  </article>

  <RelatedPosts posts={relatedPosts} />

  <script is:inline>
    (function () {
      var button = document.getElementById('share-article-button');
      var status = document.getElementById('share-article-status');
      if (!button) return;

      var title = button.getAttribute('data-share-title') || document.title;
      var text = button.getAttribute('data-share-text') || '';
      var url = button.getAttribute('data-share-url') || window.location.href;
      var statusTimer = null;

      var setStatus = function (message) {
        if (!status) return;
        status.textContent = message;
        status.hidden = !message;
        if (statusTimer) {
          window.clearTimeout(statusTimer);
        }
        if (message) {
          statusTimer = window.setTimeout(function () {
            status.hidden = true;
            status.textContent = '';
          }, 3500);
        }
      };

      var copyToClipboard = async function (value) {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(value);
          return true;
        }

        var textarea = document.createElement('textarea');
        textarea.value = value;
        textarea.setAttribute('readonly', '');
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        textarea.style.pointerEvents = 'none';
        document.body.appendChild(textarea);
        textarea.focus();
        textarea.select();
        var copied = false;
        try {
          copied = document.execCommand('copy');
        } catch (_) {
          copied = false;
        }
        document.body.removeChild(textarea);
        return copied;
      };

      var openMailFallback = function () {
        var body = text ? text + '\n\n' + url : url;
        var href = 'mailto:?subject=' + encodeURIComponent(title) + '&body=' + encodeURIComponent(body);
        window.location.href = href;
      };

      button.addEventListener('click', async function () {
        if (button.disabled) return;
        button.disabled = true;
        button.setAttribute('aria-busy', 'true');

        try {
          if (navigator.share) {
            try {
              await navigator.share({ title: title, text: text, url: url });
              setStatus('Shared successfully.');
              return;
            } catch (error) {
              if (error && typeof error === 'object' && 'name' in error && error.name === 'AbortError') {
                setStatus('');
                return;
              }
            }
          }

          try {
            var copied = await copyToClipboard(url);
            if (copied) {
              setStatus('Link copied. Paste to share.');
              return;
            }
          } catch (_) {}

          try {
            openMailFallback();
            setStatus('Opened email app for sharing.');
            return;
          } catch (_) {}

          window.prompt('Copy and share this link:', url);
          setStatus('Link ready to copy.');
        } finally {
          button.disabled = false;
          button.removeAttribute('aria-busy');
        }
      });
    })();
  </script>
  <script is:inline>
    (function () {
      var openButton = document.querySelector('[data-thumbnail-open]');
      var lightbox = document.getElementById('post-thumbnail-lightbox');
      if (!openButton || !lightbox) return;

      var closeButtons = Array.from(lightbox.querySelectorAll('[data-thumbnail-close]'));
      var closePrimary = lightbox.querySelector('.post-thumbnail-lightbox-close');
      var previousOverflow = '';
      var previousFocused = null;

      var openLightbox = function () {
        previousFocused = document.activeElement instanceof HTMLElement ? document.activeElement : null;
        previousOverflow = document.body.style.overflow;
        document.body.style.overflow = 'hidden';
        lightbox.hidden = false;
        lightbox.classList.add('is-open');
        if (closePrimary instanceof HTMLElement) {
          closePrimary.focus();
        }
      };

      var closeLightbox = function () {
        lightbox.classList.remove('is-open');
        lightbox.hidden = true;
        document.body.style.overflow = previousOverflow;
        if (previousFocused instanceof HTMLElement) {
          previousFocused.focus();
        } else if (openButton instanceof HTMLElement) {
          openButton.focus();
        }
      };

      openButton.addEventListener('click', openLightbox);

      closeButtons.forEach(function (control) {
        control.addEventListener('click', closeLightbox);
      });

      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && !lightbox.hidden) {
          closeLightbox();
        }
      });
    })();
  </script>
</BaseLayout>
