---
import { marked } from 'marked';
import BlogLayout from '../../layouts/BlogLayout.astro';
import TagBadge from '../../components/TagBadge.astro';
import { formatPostDate, getCategoryPath, getPosts, type Post } from '../../lib/posts';
import { getOpenBlogConfig } from '../../lib/site';
import { withBase } from '../../lib/paths';

export function getStaticPaths() {
  return getPosts().map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

interface Props { post: Post }
const { post } = Astro.props;
const config = getOpenBlogConfig();
const html = marked.parse(post.body);
const thumbnailSrc = post.thumbnail
  ? post.thumbnail.startsWith('http')
    ? post.thumbnail
    : withBase(post.thumbnail)
  : undefined;
---
<BlogLayout
  title={`${post.title} | ${config.title}`}
  description={post.description}
  lang={post.lang}
  ogImagePath={post.thumbnail ?? config.ogImage}
>
  <article class="card">
    <header class="post-header">
      <h1>{post.title}</h1>
      <p class="meta">
        <time datetime={post.date}>{formatPostDate(post.date)}</time>
        <span aria-hidden="true">·</span>
        <a href={withBase(getCategoryPath(post.category))}>{post.categoryLabel}</a>
      </p>
      {post.description ? <p class="lead">{post.description}</p> : null}
      {thumbnailSrc ? <img class="post-hero" src={thumbnailSrc} alt={post.thumbnailAlt ?? post.title} /> : null}
      {post.tags.length > 0 ? (
        <div class="post-card-tags">
          {post.tags.map((tag) => <TagBadge tag={tag} />)}
        </div>
      ) : null}
    </header>
    <div class="prose" set:html={html} />
  </article>
</BlogLayout>
