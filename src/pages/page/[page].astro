---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../lib/posts';
import { getOpenBlogConfig, getSiteUrl } from '../../lib/site';
import { toAbsoluteUrl } from '../../lib/seo';
import { withBase } from '../../lib/paths';

export function getStaticPaths() {
  const postsPerPage = 6;
  const remainingPosts = getPosts()
    .slice(1)
    .sort((a, b) => b.date.localeCompare(a.date) || a.slug.localeCompare(b.slug));
  const totalPages = Math.max(1, Math.ceil(remainingPosts.length / postsPerPage));
  const routePages = Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => index + 2);
  return routePages.map((page) => ({
    params: { page: String(page) }
  }));
}

const config = getOpenBlogConfig();
const posts = getPosts();
const remainingPosts = posts
  .slice(1)
  .sort((a, b) => b.date.localeCompare(a.date) || a.slug.localeCompare(b.slug));
const postsPerPage = 6;
const postsTotalPages = Math.max(1, Math.ceil(remainingPosts.length / postsPerPage));
const rawCurrentPage = Number(Astro.params.page ?? '1');

if (!Number.isFinite(rawCurrentPage) || rawCurrentPage < 2) {
  throw new Error('Invalid page number');
}

const currentPage = Math.floor(rawCurrentPage);
if (currentPage > postsTotalPages) {
  throw new Error('Page not found');
}

const pageStart = (currentPage - 1) * postsPerPage;
const paginatedPosts = remainingPosts.slice(pageStart, pageStart + postsPerPage);
const postPageNumbers = Array.from({ length: postsTotalPages }, (_, index) => index + 1);
const getHomePagePath = (page: number): string => withBase(page <= 1 ? '/' : `/page/${page}`);

const faqEntries = [
  {
    question: 'How do I publish a new post?',
    answer:
      'Create a Markdown file under content/posts/<category>/, fill in frontmatter (title, description, date, tags), then commit and open a pull request. After merge, the site rebuilds automatically.'
  },
  {
    question: 'What kinds of improvements are welcome?',
    answer:
      'New tutorials, clearer explanations, fixes to outdated snippets, better structure, and stronger references are all valuable. Small quality upgrades are welcome.'
  },
  {
    question: 'How do I brand this blog as my own?',
    answer:
      'Edit openblog.config.ts for title, tagline, colors, and navigation. Replace the logo, favicon, and Open Graph image paths listed there under public/.'
  },
  {
    question: 'Can I contribute without writing a full new post?',
    answer:
      'Yes. You can refine structure, add examples, improve language, and update technical details in existing posts through a focused pull request.'
  }
] as const;

const canonicalPath = `/page/${currentPage}`;
const pageDescription = `Browse ${config.title} archive page ${currentPage} with ${remainingPosts.length} published posts.`;
const siteUrl = getSiteUrl(Astro.site);
const canonicalUrl = toAbsoluteUrl(canonicalPath, siteUrl);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${config.title} Archive Page ${currentPage}`,
  description: pageDescription,
  url: canonicalUrl
};
---
<BaseLayout title={`${config.title} | Page ${currentPage}`} description={pageDescription} canonicalPath={canonicalPath} structuredData={structuredData}>
  <section id="home-posts" class="card list paginated-list home-posts-section">
    <div class="section-head section-head-inline">
      <div>
        <p class="kicker icon-label"><i class="ti ti-list icon-sm" aria-hidden="true"></i>Browse all stories</p>
        <h1>Complete post archive</h1>
      </div>
      <p class="meta pagination-info">Page {currentPage} of {postsTotalPages} ({remainingPosts.length} posts)</p>
    </div>

    <div class="post-grid">
      {paginatedPosts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>

    {postsTotalPages > 1 && (
      <nav class="leaderboard-pagination" aria-label="Homepage posts pages">
        <a
          id="home-posts-prev"
          class:list={['page-control', currentPage <= 1 && 'is-disabled']}
          href={getHomePagePath(Math.max(1, currentPage - 1))}
          aria-disabled={currentPage <= 1 ? 'true' : undefined}
        >
          Previous
        </a>
        <ul class="page-links" aria-label="Page numbers">
          {postPageNumbers.map((page) => (
            <li>
              <a
                class:list={['page-link', page === currentPage && 'is-active']}
                href={getHomePagePath(page)}
                aria-current={page === currentPage ? 'page' : undefined}
              >
                {page}
              </a>
            </li>
          ))}
        </ul>
        <a
          id="home-posts-next"
          class:list={['page-control', currentPage >= postsTotalPages && 'is-disabled']}
          href={getHomePagePath(Math.min(postsTotalPages, currentPage + 1))}
          aria-disabled={currentPage >= postsTotalPages ? 'true' : undefined}
        >
          Next
        </a>
      </nav>
    )}
  </section>

  <section id="home-faq" class="card home-faq">
    <div class="section-head">
      <div>
        <p class="kicker icon-label"><i class="ti ti-help-hexagon icon-sm" aria-hidden="true"></i>Getting started FAQ</p>
        <h2>Common questions before your first post</h2>
      </div>
      <p class="meta">Short answers for cloning, branding, and publishing this template.</p>
    </div>

    <div class="faq-list">
      {faqEntries.map((entry, index) => (
        <details class="faq-item" open={index === 0}>
          <summary>{entry.question}</summary>
          <p class="meta">{entry.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <style>
    .section-head {
      display: grid;
      gap: 0.32rem;
      margin-bottom: 0.55rem;
    }

    .section-head h1,
    .section-head h2 {
      margin: 0;
      font-size: 1.35rem;
    }

    .section-head-inline {
      display: flex;
      flex-wrap: wrap;
      align-items: end;
      justify-content: space-between;
      gap: 0.5rem;
      margin-bottom: 0;
    }

    .section-head-inline .meta {
      margin-left: auto;
    }

    .home-posts-section {
      gap: 0.65rem;
    }

    .home-faq {
      display: grid;
      gap: 0.62rem;
    }

    .faq-list {
      display: grid;
      gap: 0.45rem;
    }

    .faq-item {
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      background: var(--surface);
      padding: 0.5rem 0.62rem;
    }

    .faq-item[open] {
      border-color: color-mix(in srgb, var(--primary) 45%, var(--border));
      background: var(--surface);
    }

    .faq-item summary {
      cursor: pointer;
      font-family: var(--font-main);
      font-size: 0.88rem;
      font-weight: 700;
      line-height: 1.35;
      color: var(--text);
    }

    .faq-item .meta {
      margin: 0.42rem 0 0;
      font-size: 0.8rem;
      line-height: 1.45;
    }

    .leaderboard-pagination {
      margin-top: 0.45rem;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
    }

    .page-links {
      margin: 0;
      padding: 0;
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
    }

    .page-control,
    .page-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 2rem;
      min-height: 2rem;
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      background: var(--surface);
      color: var(--text);
      font-family: var(--font-main);
      font-size: 0.82rem;
      font-weight: 600;
      line-height: 1;
      padding: 0.35rem 0.55rem;
      text-decoration: none;
    }

    .page-link.is-active {
      border-color: var(--primary);
      background: var(--surface-soft);
      color: var(--primary);
      text-decoration: none;
    }

    .page-control.is-disabled {
      opacity: 0.55;
      pointer-events: none;
    }

    @media (max-width: 860px) {
      .leaderboard-pagination {
        justify-content: center;
      }

      .section-head h1,
      .section-head h2 {
        font-size: 1.15rem;
      }

      .section-head-inline .meta {
        margin-left: 0;
      }
    }
  </style>
</BaseLayout>
