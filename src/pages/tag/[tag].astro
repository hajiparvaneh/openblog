---
import BlogLayout from '../../layouts/BlogLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPostsByTagSlug, getTagRecords } from '../../lib/posts';
import { getOpenBlogConfig } from '../../lib/site';

export function getStaticPaths() {
  return getTagRecords().map((tag) => ({
    params: { tag: tag.slug },
    props: { label: tag.label, posts: getPostsByTagSlug(tag.slug) }
  }));
}

interface Props {
  label: string;
  posts: ReturnType<typeof getPostsByTagSlug>;
}

const { label, posts } = Astro.props;
const config = getOpenBlogConfig();
---
<BlogLayout title={`${label} | ${config.title}`} description={`Posts tagged ${label} on ${config.title}.`}>
  <section class="card">
    <p class="kicker icon-label"><i class="ti ti-tag icon-sm" aria-hidden="true"></i>Tag</p>
    <h1>{label}</h1>
    <p class="meta">{posts.length} post{posts.length === 1 ? '' : 's'}</p>
  </section>

  <section class="card list">
    <div class="post-grid">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BlogLayout>
