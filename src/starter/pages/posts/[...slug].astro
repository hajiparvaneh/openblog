---
import { marked } from 'marked';
import BlogLayout from '../../layouts/BlogLayout.astro';
import { formatPostDate, getCategoryPath, getPosts } from '../../../lib/openblog';
import type { Post } from '../../../lib/openblog';
import TagBadge from '../../../components/TagBadge.astro';
export function getStaticPaths() {
  return getPosts().map(post => ({ params: { slug: post.slug }, props: { post } }));
}
interface Props { post: Post; }
const { post } = Astro.props;
const html = marked.parse(post.body);
---
<BlogLayout title={`${post.title} | OpenBlog`} description={post.description} lang={post.lang}>
  <article class="card">
    <header>
      <h1>{post.title}</h1>
      <p class="meta"><time datetime={post.date}>{formatPostDate(post.date)}</time> · <a href={getCategoryPath(post.category)}>{post.categoryLabel}</a></p>
      <p>{post.description}</p>
      {post.thumbnail && <img src={post.thumbnail} alt={post.thumbnailAlt ?? post.title} />}
      <div class="label-row">{post.tags.map(tag => <TagBadge tag={tag} />)}</div>
    </header>
    <div class="article-content" set:html={html} />
  </article>
</BlogLayout>
