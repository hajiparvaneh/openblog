---
import BlogLayout from '../../layouts/BlogLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { getPosts } from '../../../lib/openblog';
export function getStaticPaths() {
  const posts = getPosts();
  return [...new Set(posts.map(post => post.category))].map(category => ({
    params: { category }, props: { posts: posts.filter(post => post.category === category) }
  }));
}
const { posts } = Astro.props;
const label = posts[0].categoryLabel;
---
<BlogLayout title={`${label} | OpenBlog`}>
  <h1>{label}</h1>
  <div class="grid">{posts.map(post => <PostCard post={post} showCategory={false} showContributors={false} />)}</div>
</BlogLayout>
