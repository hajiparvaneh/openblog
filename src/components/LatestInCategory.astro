---
import PostCard from './PostCard.astro';
import { getPosts } from '../lib/posts';

type Props = {
  category: string;
  currentPostSlug: string;
  limit?: number;
  title?: string;
  emptyMessage?: string;
};

const {
  category,
  currentPostSlug,
  limit = 6,
  title,
  emptyMessage = 'No other posts in this category yet.'
} = Astro.props as Props;
const sectionTitle = title ?? 'Related posts';

const latestInCategory = getPosts()
  .filter((categoryPost) => categoryPost.category === category && categoryPost.slug !== currentPostSlug)
  .sort((a, b) => b.date.localeCompare(a.date) || a.slug.localeCompare(b.slug))
  .slice(0, limit);
---

<section class="card category-latest-posts">
  <p class="kicker icon-label"><i class="ti ti-clock-hour-4 icon-sm" aria-hidden="true"></i>{sectionTitle}</p>
  {latestInCategory.length === 0 ? (
    <p class="meta">{emptyMessage}</p>
  ) : (
    <div class="post-grid">
      {latestInCategory.map((categoryPost) => (
        <PostCard post={categoryPost} showCategory={false} />
      ))}
    </div>
  )}
</section>
