---
import { formatPostDate, getCategoryPath, getPostPath, type Post } from '../lib/posts';
import TagBadge from './TagBadge.astro';
import { withBase } from '../lib/paths';

type Props = {
  post: Post;
  showCategory?: boolean;
};

const { post, showCategory = true } = Astro.props;
const postPath = withBase(getPostPath(post.slug));
const categoryPath = withBase(getCategoryPath(post.category));
const thumbnailSrc = post.thumbnail
  ? post.thumbnail.startsWith('http')
    ? post.thumbnail
    : withBase(post.thumbnail)
  : undefined;
---
<article class="card post-card">
  {thumbnailSrc ? (
    <a class="post-card-thumb-link" href={postPath} aria-label={`Read ${post.title}`}>
      <img class="post-card-thumb" src={thumbnailSrc} alt={post.thumbnailAlt ?? post.title} loading="lazy" />
    </a>
  ) : null}
  <div class="post-card-body">
    <h2 class="post-card-title"><a href={postPath}>{post.title}</a></h2>
    {post.description ? <p class="post-card-description">{post.description}</p> : null}
    {post.tags.length > 0 ? (
      <div class="post-card-tags">
        {post.tags.slice(0, 4).map((tag) => <TagBadge tag={tag} />)}
      </div>
    ) : null}
    <p class="meta">
      <time datetime={post.date}>{formatPostDate(post.date)}</time>
      {showCategory ? (
        <>
          <span aria-hidden="true">·</span>
          <a href={categoryPath}>{post.categoryLabel}</a>
        </>
      ) : null}
    </p>
  </div>
</article>
