---
import { formatPostDate, formatReadingTime, getCategoryPath, getPostPath, getSeriesPath } from '../lib/posts';
import { withBase } from '../lib/paths';
import IconBadge from './IconBadge.astro';
import LanguageLabel from './LanguageLabel.astro';
import TagBadge from './TagBadge.astro';
import type { Post } from '../lib/posts';

type Props = {
  post: Post;
  showCategory?: boolean;
  dataAttribute?: string;
  dateSortValue?: string;
  displayDate?: string;
  eyebrow?: string;
};

const { post, showCategory = true, dataAttribute, dateSortValue, displayDate, eyebrow } = Astro.props as Props;
const cardAttributes = {
  ...(dataAttribute ? { [dataAttribute]: '' } : {}),
  ...(dateSortValue ? { 'data-post-date': dateSortValue } : {})
};
const postPath = withBase(getPostPath(post.slug));
const thumbnailSrc = post.thumbnail
  ? post.thumbnail.startsWith('http')
    ? post.thumbnail
    : withBase(post.thumbnail)
  : undefined;
const visibleTags = post.tags.slice(0, 3);
const hiddenTagCount = Math.max(0, post.tags.length - visibleTags.length);
---

<article class="card post-card post-card-standard" {...cardAttributes}>
  {thumbnailSrc ? (
    <a class="post-card-inline-thumbnail-link" href={postPath} aria-label={`Read ${post.title}`}>
      <img
        class="post-card-inline-thumbnail"
        src={thumbnailSrc}
        alt={post.thumbnailAlt ?? post.title}
        loading="lazy"
        decoding="async"
      />
    </a>
  ) : null}
  <div class="post-card-standard-body">
    {eyebrow ? (
      <p class="kicker icon-label post-card-eyebrow">
        <i class="ti ti-list-numbers icon-sm" aria-hidden="true"></i>
        {eyebrow}
      </p>
    ) : null}
    <h2 class="post-card-title"><a href={postPath}>{post.title}</a></h2>
    <p class="post-card-description">{post.description}</p>
    {(post.featured || post.lang || post.tags.length > 0) ? (
      <div class="post-card-taxonomy">
        {post.featured ? <IconBadge label="Featured" icon="star-filled" class="post-card-flag" /> : null}
        <LanguageLabel lang={post.lang} class="post-card-flag" />
        {visibleTags.map((tag) => (
          <TagBadge tag={tag} class="post-card-tag" />
        ))}
        {hiddenTagCount > 0 ? <span class="post-card-tag post-tag-more">+{hiddenTagCount}</span> : null}
      </div>
    ) : null}
    <p class="meta meta-inline">
      <span class="meta-item">
        <i class="ti ti-calendar icon-sm" aria-hidden="true"></i>
        {formatPostDate(displayDate ?? post.date)}
      </span>
      <span class="meta-item">
        <i class="ti ti-clock-hour-4 icon-sm" aria-hidden="true"></i>
        {formatReadingTime(post.readingMinutes)}
      </span>
      {post.series && post.seriesSlug ? (
        <span class="meta-item">
          <i class="ti ti-list-numbers icon-sm" aria-hidden="true"></i>
          <a href={withBase(getSeriesPath(post.seriesSlug))}>{post.series}</a>
        </span>
      ) : null}
      {showCategory ? (
        <span class="meta-item">
          <i class="ti ti-category icon-sm" aria-hidden="true"></i>
          <a href={withBase(getCategoryPath(post.category))}>{post.categoryLabel}</a>
        </span>
      ) : null}
    </p>
  </div>
</article>
