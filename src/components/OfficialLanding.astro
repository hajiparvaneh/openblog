---
import { getOpenBlogConfig, getSiteUrl } from '../lib/site';
import { toAbsoluteUrl } from '../lib/seo';
import { withBase } from '../lib/paths';

const config = getOpenBlogConfig();
const siteUrl = getSiteUrl(Astro.site);
const abs = (path: string) => toAbsoluteUrl(withBase(path).replace(/^\/+/, ''), siteUrl);
const canonicalUrl = abs('/');
const logoHref = withBase(config.logo.light);
const ogAbsolute = abs(config.ogImage);
const faviconHref = withBase(config.favicon);
const templateUrl = 'https://github.com/new?template_name=openblog&template_owner=hajiparvaneh';
const repoUrl = config.repositoryUrl || 'https://github.com/hajiparvaneh/openblog';
const docsUrl = `${repoUrl}/blob/main/docs/README.md`;
const startDocsUrl = `${repoUrl}/blob/main/docs/start.md`;
const pageTitle = `${config.title} — Free Markdown blog template`;
const pageDescription =
  'OpenBlog is a free, open-source, file-based blog. Write Markdown in git, publish a static site, no database or secrets.';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogAbsolute} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={faviconHref} sizes="any" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
<!-- Keep styles inline: this page is dynamically imported by the official-site flag. -->
<style is:inline>
  :root {
    color-scheme: light;
    --blue: #0969da;
    --ink: #1f2328;
    --muted: #59636e;
    --line: #dce3eb;
  }
  * {
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
    scroll-padding-top: 24px;
  }
  body {
    margin: 0;
    color: var(--ink);
    background: #fff;
    font-family: 'Figtree', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: 16px;
    line-height: 1.65;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  a:hover {
    color: var(--blue);
  }
  a:focus-visible {
    outline: 3px solid var(--blue);
    outline-offset: 5px;
  }
  h1,h2,h3,p {
    margin: 0;
  }
  h1,h2,h3 {
    line-height: 1.15;
  }
  h2 {
    font-size: clamp(30px, 3.2vw, 43px);
    letter-spacing: -1.5px;
    font-weight: 600;
  }
  h3 {
    font-size: 20px;
    font-weight: 600;
  }
  .wrap {
    width: min(1180px, calc(100% - 80px));
    margin-inline: auto;
  }
  .blue {
    color: var(--blue);
  }
  .skip-link {
    position: fixed;
    top: -100px;
    left: 20px;
    padding: 12px;
    background: white;
    z-index: 10;
  }
  .skip-link:focus {
    top: 10px;
  }
  .topbar {
    height: 98px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
    gap: 24px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 25px;
    font-weight: 800;
    letter-spacing: -.9px;
  }
  .brand img {
    object-fit: contain;
  }
  nav {
    display: flex;
    gap: 32px;
    font-size: 14px;
    font-weight: 600;
  }
  .repo-link {
    font-size: 14px;
    font-weight: 700;
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 8px 17px;
  }
  .repo-link span {
    margin-left: 14px;
  }
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 36px;
    align-items: center;
    padding-block: 92px 86px;
  }
  .eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.7px;
    color: var(--blue);
    margin-bottom: 23px;
  }
  .status-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    background: #2da44e;
    border-radius: 50%;
    margin-right: 8px;
  }
  h1 {
    font-size: clamp(52px, 5.6vw, 76px);
    line-height: 1.02;
    letter-spacing: -3.5px;
    font-weight: 600;
  }
  .lede {
    font-size: 18px;
    color: var(--muted);
    margin-top: 28px;
    line-height: 1.7;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 25px;
    margin-top: 30px;
  }
  .button {
    display: inline-flex;
    gap: 26px;
    align-items: center;
    justify-content: center;
    padding: 13px 21px;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 700;
  }
  .primary {
    background: var(--blue);
    color: white;
    box-shadow: 0 3px 5px #0969da12;
  }
  .primary:hover {
    background: #0550ae;
    color: white;
  }
  .text-link {
    color: var(--blue);
    font-size: 14px;
    font-weight: 700;
  }
  .text-link:hover {
    text-decoration: underline;
  }
  .hero-note {
    color: var(--muted);
    font-size: 12px;
    margin-top: 19px;
  }
  .showcase {
    position: relative;
    min-width: 0;
    padding: 20px 0 64px 30px;
  }
  .orbit {
    position: absolute;
    inset: -30px -15px 15px;
    background: radial-gradient(ellipse, #dcecff 0%, #f3f8ff 48%, transparent 72%);
    z-index: -1;
  }
  .preview-window {
    background: white;
    border: 1px solid #cdd8e5;
    border-radius: 9px;
    overflow: hidden;
    box-shadow: 0 20px 60px #243f6420;
    transform: rotate(-2deg);
  }
  .window-bar {
    display: flex;
    justify-content: space-between;
    background: #f6f8fa;
    border-bottom: 1px solid var(--line);
    padding: 10px 14px;
    color: #6b7b8b;
    font-size: 9px;
  }
  .dots {
    color: #a9b7c7;
    letter-spacing: 2px;
  }
  .mini-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 23px;
    background: #24292f;
    color: white;
  }
  .mini-nav strong {
    font-size: 18px;
  }
  .mini-nav .blue {
    color: #58a6ff;
  }
  .mini-nav>span {
    font-size: 9px;
    color: #c9d1d9;
  }
  .preview-body {
    padding: 24px 25px 100px;
  }
  .mini-label {
    font-size: 7px;
    letter-spacing: 1.3px;
    color: var(--muted);
  }
  .preview-body h2 {
    font-size: 27px;
    letter-spacing: -.8px;
    margin: 9px 0;
  }
  .preview-body p {
    font-size: 10px;
    color: var(--muted);
  }
  .article-art {
    height: 112px;
    background: #e9f2ff;
    margin-top: 20px;
    display: grid;
    place-items: center;
    overflow: hidden;
    position: relative;
  }
  .article-art>span {
    font-family: monospace;
    font-size: 44px;
    color: #8bbcf9;
    z-index: 1;
  }
  .article-art b {
    font-size: 21px;
    color: #0969da;
    margin: 0 15px;
    font-weight: 500;
  }
  .article-art i {
    width: 180px;
    height: 180px;
    border: 1px solid #c2dcff;
    position: absolute;
    transform: rotate(35deg);
  }
  .mini-tags {
    display: flex;
    gap: 6px;
    margin: 15px 0 8px;
  }
  .mini-tags span {
    border-radius: 12px;
    padding: 1px 7px;
    background: #f0f4f8;
    color: #59636e;
    font-size: 8px;
  }
  .preview-body h3 {
    font-size: 14px;
    margin-bottom: 5px;
  }
  .code-window {
    position: absolute;
    bottom: 36px;
    left: 0;
    right: 30px;
    background: #161b22;
    border: 1px solid #30363d;
    border-radius: 8px;
    box-shadow: 0 18px 36px #0d11172b;
    color: #c9d1d9;
    transform: rotate(1deg);
  }
  .code-title {
    padding: 11px 15px;
    border-bottom: 1px solid #30363d;
    font-family: monospace;
    font-size: 10px;
  }
  .code-title>span:last-child {
    float: right;
    color: #9da7b3;
    font-size: 9px;
  }
  .code-title .status-dot {
    width: 6px;
    height: 6px;
  }
  pre {
    margin: 0;
    padding: 16px 20px;
    font-size: 11px;
    line-height: 1.7;
    overflow-x: auto;
  }
  .code-muted {
    color: #8b949e;
  }
  .code-key {
    color: #79c0ff;
  }
  .code-heading {
    color: #a5d6ff;
  }
  .code-footer {
    display: flex;
    justify-content: space-between;
    padding: 8px 15px;
    border-top: 1px solid #30363d;
    font-size: 9px;
    color: #9da7b3;
  }
  .code-footer span:first-child {
    color: #7ee787;
  }
  .example-label {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    text-align: center;
    color: #687b90;
    font-size: 8px;
    letter-spacing: 1.7px;
  }
  .principles {
    border-block: 1px solid var(--line);
    background: #f8fafc;
  }
  .principles .wrap {
    display: flex;
    justify-content: space-between;
    padding-block: 24px;
    color: var(--muted);
    font-size: 14px;
  }
  .principles strong {
    color: var(--ink);
    margin-left: 5px;
  }
  .section {
    padding-block: 90px;
  }
  .section-intro {
    text-align: center;
  }
  .section-intro>p:last-child {
    margin-top: 19px;
    color: var(--muted);
  }
  .features {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 45px 55px;
    margin-top: 60px;
  }
  .feature-icon {
    display: block;
    color: var(--blue);
    font-family: monospace;
    font-size: 25px;
    height: 48px;
  }
  .features h3 {
    margin-bottom: 12px;
  }
  .features p {
    color: var(--muted);
    font-size: 15px;
  }
  .getting-started {
    background: #f6f8fa;
    border-block: 1px solid var(--line);
    padding-block: 75px;
  }
  .start-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 90px;
  }
  .start-grid h2+p {
    color: var(--muted);
    margin: 20px 0;
  }
  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 28px;
  }
  .steps li {
    display: flex;
    gap: 23px;
  }
  .steps li>span {
    font-family: monospace;
    font-size: 15px;
    color: var(--blue);
    padding-top: 2px;
  }
  .steps h3 {
    margin-bottom: 9px;
  }
  .steps p {
    color: var(--muted);
    font-size: 14px;
  }
  .steps a {
    color: var(--blue);
  }
  code {
    font-size: .9em;
  }
  .creator {
    display: grid;
    grid-template-columns: 210px 1fr;
    gap: 65px;
    align-items: center;
    max-width: 960px;
  }
  .creator-monogram {
    height: 210px;
    display: grid;
    align-content: center;
    justify-content: center;
    grid-template-columns: auto auto;
    background: #edf4fe;
    color: var(--blue);
    font-size: 76px;
    font-weight: 500;
    letter-spacing: -9px;
    border-radius: 50%;
    font-family: monospace;
  }
  .creator-monogram span {
    color: #89b6ef;
  }
  .creator h2 {
    font-size: 34px;
    letter-spacing: -1px;
  }
  .creator .eyebrow {
    margin-bottom: 14px;
  }
  .role {
    color: var(--blue);
    margin-top: 10px;
    font-weight: 600;
  }
  .creator-copy>p:not(.eyebrow):not(.role) {
    color: var(--muted);
    margin: 17px 0;
  }
  .closing {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    padding: 45px 50px;
    background: #edf4fe;
    border: 1px solid #d9e7f9;
    border-radius: 8px;
    margin-bottom: 65px;
  }
  .closing .eyebrow {
    margin-bottom: 12px;
  }
  .closing h2 {
    font-size: 36px;
  }
  .closing h2+p {
    color: var(--muted);
    margin-top: 13px;
  }
  .closing .button {
    flex-shrink: 0;
  }
  footer {
    border-top: 1px solid var(--line);
    padding-block: 30px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
  }
  footer strong {
    font-size: 20px;
  }
  footer p {
    color: var(--muted);
    font-size: 12px;
    margin-top: 6px;
  }
  .footer-links {
    display: flex;
    gap: 24px;
    font-size: 12px;
  }
  @media(max-width: 1000px) {
    .wrap {
      width: calc(100% - 48px);
    }
    .hero {
      gap: 25px;
      padding-block: 65px;
    }
    h1 {
      font-size: 60px;
    }
    .hero .eyebrow {
      font-size: 9px;
      letter-spacing: 1px;
    }
    .actions {
      gap: 15px;
      flex-wrap: wrap;
    }
    .showcase {
      padding-left: 15px;
    }
    .code-window {
      right: 0;
    }
    .code-title>span:last-child {
      display: none;
    }
    .features {
      gap: 35px;
    }
    .start-grid {
      gap: 45px;
    }
    .creator {
      gap: 35px;
    }
    .desktop-break {
      display: none;
    }
  }
  @media(max-width: 700px) {
    .wrap {
      width: calc(100% - 40px);
    }
    .topbar {
      height: auto;
      min-height: 80px;
      flex-wrap: wrap;
      gap: 12px;
      padding-block: 16px;
    }
    .brand {
      font-size: 23px;
    }
    .brand img {
      width: 34px;
      height: 34px;
    }
    nav {
      order: 3;
      width: 100%;
      justify-content: space-between;
      font-size: 12px;
      gap: 16px;
      padding-top: 10px;
    }
    .hero {
      grid-template-columns: 1fr;
      padding-block: 48px;
      gap: 36px;
    }
    h1 {
      font-size: clamp(51px, 12vw, 72px);
      letter-spacing: -2.5px;
    }
    .hero .eyebrow {
      font-size: 9px;
    }
    .lede {
      font-size: 17px;
    }
    .hero-note {
      font-size: 11px;
    }
    .showcase {
      max-width: 490px;
      width: 100%;
      margin-inline: auto;
    }
    .preview-body {
      padding-bottom: 115px;
    }
    .principles .wrap {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      font-size: 12px;
    }
    .section {
      padding-block: 60px;
    }
    .features {
      grid-template-columns: 1fr;
      gap: 30px;
      margin-top: 40px;
    }
    .features article {
      padding-bottom: 25px;
      border-bottom: 1px solid var(--line);
    }
    .features h3 {
      font-size: 20px;
    }
    .section-intro {
      text-align: left;
    }
    .start-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .getting-started {
      padding-block: 55px;
    }
    .creator {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .creator-monogram {
      width: 110px;
      height: 110px;
      font-size: 42px;
      letter-spacing: -5px;
    }
    .creator h2 {
      font-size: 30px;
    }
    .closing {
      flex-direction: column;
      align-items: flex-start;
      padding: 28px;
      margin-bottom: 40px;
    }
    .closing h2 {
      font-size: 30px;
    }
    footer {
      flex-direction: column;
      align-items: flex-start;
    }
    .code-title {
      font-size: 9px;
    }
    pre {
      font-size: 10px;
    }
    .preview-body h2 {
      font-size: 25px;
    }
  }
  @media(prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  /* A continuous, full-width opening inspired by the Material reference. */
  .masthead { background: #101b2d; color: #fff; }
  .topbar { height: 88px; border-color: #ffffff1f; }
  .masthead .blue { color: #79b8ff; }
  .masthead a:hover { color: #a5d0ff; }
  .repo-link { border-color: #ffffff38; background: #ffffff08; }
  .hero-stage {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: radial-gradient(ellipse at 85% 45%, #254e7d 0%, transparent 55%), linear-gradient(155deg, #101b2d 12%, #152c47 65%, #213f60);
  }
  .hero-stage::before, .hero-stage::after {
    content: '';
    position: absolute;
    width: 110%;
    height: 300px;
    bottom: -230px;
    left: -10%;
    background: #ffffff04;
    border-top: 1px solid #ffffff0c;
    transform: rotate(-9deg);
    z-index: -1;
  }
  .hero-stage::after { bottom: -180px; left: 15%; transform: rotate(12deg); }
  .hero { min-height: min(800px, calc(100svh - 88px)); padding-block: 75px 95px; }
  .hero-copy { color: #fff; }
  .hero-copy .blue { color: #79b8ff; }
  .hero-copy .eyebrow { color: #a5d0ff; }
  .hero-copy .lede { color: #d0dbe7; }
  .hero-copy .hero-note { color: #afc0d2; }
  .hero-copy .text-link { color: #c4e0ff; }
  .hero-copy .primary { background: #fff; color: #123c69; }
  .hero-copy .primary:hover { background: #dcecff; }
  .orbit { background: radial-gradient(ellipse, #70b6ff24, transparent 70%); }
  .example-label { color: #b5cce5; }
  .hero-scroll { display: block; position: absolute; bottom: 18px; left: calc(50% - 22px); width: 44px; text-align: center; font-size: 25px; color: #b5cce5; }
  .hero-scroll:hover { color: #fff; }
  .creator { grid-template-columns: 240px 1fr; }
  .creator-portrait { display: block; width: 240px; height: 280px; object-fit: cover; object-position: center; filter: grayscale(1); border-radius: 8px; box-shadow: 12px 12px 0 #edf1f5; }
  @media (max-width: 700px) {
    .topbar { height: auto; }
    .hero { min-height: auto; padding-block: 50px 75px; }
    .creator { grid-template-columns: 1fr; }
    .creator-portrait { width: 180px; height: 210px; }
  }
</style>

  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="masthead"><div class="topbar wrap">
      <a class="brand" href={withBase('/')} aria-label="OpenBlog home"><img src={logoHref} alt="" width="42" height="42" /><span>Open<span class="blue">Blog</span></span></a>
      <nav aria-label="Main navigation"><a href="#features">Features</a><a href="#start">Get started</a><a href={docsUrl}>Documentation</a><a href="#creator">The creator</a></nav>
      <a class="repo-link" href={repoUrl}>GitHub <span aria-hidden="true">↗</span></a>
    </div></header>
    <main id="main">
      <section class="hero-stage"><div class="hero wrap">
        <div class="hero-copy">
          <p class="eyebrow"><span class="status-dot"></span> OPEN SOURCE. YOUR WORDS. YOUR SPACE.</p>
          <h1>Good ideas<br />deserve an<br /><span class="blue">open home.</span></h1>
          <p class="lede">A beautiful blog, powered by Markdown and git.<br class="desktop-break" /> Write what matters. Make it yours. Publish anywhere.</p>
          <div class="actions"><a class="button primary" href={templateUrl}>Create your blog <span aria-hidden="true">→</span></a><a class="text-link" href={docsUrl}>Explore the docs <span aria-hidden="true">↗</span></a></div>
          <p class="hero-note">Free forever under MIT. No database. No API keys.</p>
        </div>
        <div class="showcase" aria-label="Illustration of a Markdown post becoming an OpenBlog article">
          <div class="orbit" aria-hidden="true"></div>
          <div class="preview-window">
            <div class="window-bar"><span class="dots" aria-hidden="true">● ● ●</span><span>your-blog / a space to share</span><span aria-hidden="true">↗</span></div>
            <div class="mini-nav"><strong>Open<span class="blue">Blog</span></strong><span>Home &nbsp; About &nbsp; ◐</span></div>
            <div class="preview-body"><span class="mini-label">THOUGHTS, NOTES & LITTLE DISCOVERIES</span><h2>A little curiosity.<br />A world of possibilities.</h2><p>A place for the things you build, learn, and want to share.</p><div class="article-art" aria-hidden="true"><span>{'{'}<b>hello, world.</b>{'}'}</span><i></i></div><div class="mini-tags"><span>Writing</span><span>Getting started</span></div><h3>Every great idea starts with a first post.</h3><p>Your story belongs here.</p></div>
          </div>
          <div class="code-window"><div class="code-title"><span class="status-dot"></span> content/posts/hello-world.md <span>Markdown</span></div><pre><code><span class="code-muted">---</span>
<span class="code-key">title:</span> Hello, world.
<span class="code-key">tags:</span> [ideas, beginnings]
