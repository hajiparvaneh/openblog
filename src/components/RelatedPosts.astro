---
import PostCard from './PostCard.astro';
import type { Post } from '../lib/posts';

type Props = {
  posts: Post[];
};

const { posts } = Astro.props as Props;
---

<section class="card" aria-labelledby="related-posts-title">
  <h2 id="related-posts-title" class="kicker icon-label">
    <i class="ti ti-link icon-sm" aria-hidden="true"></i>
    Related posts
  </h2>
  {posts.length === 0 ? (
    <p class="meta">No related posts yet. Posts that share a tag or category show up here.</p>
  ) : (
    <div class="post-grid">
      {posts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  )}
</section>
