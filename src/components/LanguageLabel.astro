---
import { languageFlagSvg } from '../lib/language-flags';
import { languageLabel } from '../lib/posts';

type Props = {
  lang: string;
  class?: string;
  bare?: boolean;
};

const { lang, class: className = '', bare = false } = Astro.props as Props;
const rootClass = `${bare ? '' : 'post-chip-label '}language-label ${className}`.trim();
---

<span class={rootClass}>
  <span class="language-flag" aria-hidden="true" set:html={languageFlagSvg(lang)} />
  <span>{languageLabel(lang)}</span>
</span>
